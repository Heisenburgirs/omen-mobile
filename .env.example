# Public identifiers from Privy Dashboard > your app > App settings / App clients.
EXPO_PUBLIC_PRIVY_APP_ID=
# Development mobile app client (Allowed app identifier xyz.getomen.app.dev,
# URL scheme omen-dev). The production client id is passed to
# scripts/release.ps1 (-PrivyClientId or OMEN_PRIVY_PRODUCTION_CLIENT_ID).
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Android emulator reaches the API through adb reverse (the launcher configures it).
EXPO_PUBLIC_API_URL=http://127.0.0.1:3100
EXPO_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Must match the app's network. OMEN uses Solana mainnet.

# Mobile data services. Server only; never use EXPO_PUBLIC_ for these.

# The app talks to the OMEN website, which is the one backend for the site and
# the app (Birdeye market data, Supabase, Helius, Privy verification all live
# there). Dev: run "npm run dev" in omen-landing (port 3100) and let
# scripts/android.ps1 forward it into the emulator. Production builds use
# https://www.getomen.xyz. Never put API keys in this file; EXPO_PUBLIC_
# values ship inside the app.
